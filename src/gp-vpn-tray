    except GLib.Error:
        pass


def draw_globe(cr, w, h, state, angle):
    cx, cy, r = w / 2, h / 2, min(w, h) / 2 - 8
    c = COLORS[state]
    tau = 2 * math.pi
    cr.set_line_cap(cairo.LINE_CAP_ROUND)
    # Подложка и кольцо: целое — подключено/отключено, бегущая дуга — идёт подключение
    cr.set_source_rgba(*c, 0.10)
    cr.arc(cx, cy, r, 0, tau)
    cr.fill()
    cr.set_line_width(5)
    if state in BUSY:
        cr.set_source_rgba(*c, 0.22)
        cr.arc(cx, cy, r, 0, tau)
        cr.stroke()
        cr.set_source_rgb(*c)
        cr.arc(cx, cy, r, angle, angle + 1.7)
    else:
        cr.set_source_rgba(*c, 0.45 if state == "off" else 1)
        cr.arc(cx, cy, r, 0, tau)
    cr.stroke()
    # Глобус: контур, меридианы, параллели
    g = r * 0.52
    cr.set_source_rgba(*c, 0.7 if state == "off" else 0.95)
    cr.set_line_width(2.2)
    cr.arc(cx, cy, g, 0, tau)
    cr.stroke()
    cr.save()
    cr.translate(cx, cy)
    cr.scale(0.45, 1)
    cr.arc(0, 0, g, 0, tau)
    cr.restore()
    cr.stroke()
    cr.move_to(cx, cy - g)
    cr.line_to(cx, cy + g)
    for k in (-0.5, 0, 0.5):
        half = g * math.sqrt(1 - k * k)
        cr.move_to(cx - half, cy + k * g)
        cr.line_to(cx + half, cy + k * g)
    cr.stroke()
    # Галочка «защищено» на кольце
    if state in ("on", "internal"):
        bx, by, br = cx + r * 0.707, cy + r * 0.707, r * 0.22
        cr.set_source_rgb(*CARD)
        cr.arc(bx, by, br + 4, 0, tau)
        cr.fill()
        cr.set_source_rgb(*c)
        cr.arc(bx, by, br, 0, tau)
        cr.fill()
        cr.set_source_rgb(*CARD)
        cr.set_line_width(3)
        cr.move_to(bx - br * 0.45, by + br * 0.02)
        cr.line_to(bx - br * 0.1, by + br * 0.38)
        cr.line_to(bx + br * 0.48, by - br * 0.32)
        cr.stroke()


def styled(widget, *classes):
    for c in classes:
        widget.get_style_context().add_class(c)
    return widget


class Session:
    """Диалог с CLI через помощник «gpvpn.py session»: запросы -> on_prompt(сессия, вид, текст, варианты),
    конец -> on_done(сессия, итог). Логин, пароль и нужный гейт помощник подставляет сам."""

    def __init__(self, args, creds, on_prompt, on_done):
        self.args, self.on_prompt, self.on_done, self.cancelling = args, on_prompt, on_done, False
        self.p = subprocess.Popen([sys.executable, gpvpn.__file__, "session", *args],
                                  stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True, bufsize=1)
        self.write(creds)
        GLib.io_add_watch(self.p.stdout.fileno(), GLib.IO_IN | GLib.IO_HUP | GLib.IO_ERR, self.read)

    def write(self, obj):
        try:
            self.p.stdin.write(json.dumps(obj, ensure_ascii=False) + "\n")
            self.p.stdin.flush()
        except OSError:
            pass

    def read(self, fd, cond):
        line = self.p.stdout.readline()
        if not line:
            self.p.wait()
            self.on_done(self, {"rc": self.p.returncode or 1, "cancelled": self.cancelling, "error": "", "output": ""})
            return False
        e = json.loads(line)
        if e["event"] == "prompt":
            self.on_prompt(self, e["kind"], e["text"], e["options"])
            return True
        self.p.stdout.close()
        self.p.wait()
        self.on_done(self, e)
        return False

    def send(self, answer):
        self.write({"answer": answer})

    def cancel(self):
        self.cancelling = True
        self.write({"cancel": True})


class Tray:
    def __init__(self):
        self.state, self.details, self.gws = None, {}, []
        self.since = None
        self.session = None           # идёт диалог с CLI (подключение, отключение, смена гейта…)
        self.busy = None              # "connecting"/"disconnecting" на время диалога
        self.question = None          # (вид, варианты) — CLI ждёт ответа пользователя
        self.pw = self.pending_pw = None  # пароль хранится только в памяти
        self.log = []                 # стенограммы диалогов с CLI (без ответов пользователя)
        self.angle, self.spinning = 0.0, None
        self.hidden_at, self.pos, self.anchor, self.filling = 0.0, None, None, False
        self.icon = Gtk.StatusIcon(title=T)
        self.icon.connect("activate", lambda i: self.toggle(at_pointer=True))
        self.icon.connect("popup-menu", lambda i, b, t: self.toggle(at_pointer=True))
        GLib.timeout_add_seconds(20, self.ensure_extensions)  # расширения оболочки грузятся не сразу
        self.build()
        self.refresh()
        self.poke = threading.Event()
        threading.Thread(target=self.poll, daemon=True).start()

    def ensure_extensions(self):
        # Кнопка VPN на экране блокировки — наше расширение оболочки; в чистом GNOME трея нет —
        # включаем и AppIndicator (он показывает и такие значки)
        src = Gio.SettingsSchemaSource.get_default()
        if not src or not src.lookup("org.gnome.shell", True):
            return False
        s = Gio.Settings.new("org.gnome.shell")
        exts = s.get_strv("enabled-extensions")
        want = [e for e in (SHELL_EXT,) if e not in exts and os.path.isdir(f"/usr/share/gnome-shell/extensions/{e}")]
        if (not self.icon.is_embedded() and os.path.isdir(f"/usr/share/gnome-shell/extensions/{APPINDICATOR}")
                and not any("tray" in e.lower() or "indicator" in e.lower() for e in exts)):
            want.append(APPINDICATOR)
        if want:
            s.set_strv("enabled-extensions", exts + want)
        return False

    # ---------- фон: состояние клиента ----------
    def poll(self):
        last_info = 0
        while True:
            if not self.session:
                rc, out = gp("show", "--status")
                st = parse_status(out) if rc == 0 else None
                info = None
                if st and (time.monotonic() - last_info > 10 or self.poke.is_set()):
                    det = parse_fields(gp("show", "--details")[1]) if st in ("on", "internal") else {}
                    info = (det, parse_gateways(gp("show", "--manual-gateway")[1]))
                    last_info = time.monotonic()
                self.poke.clear()
                GLib.idle_add(self.polled, st, info)
            self.poke.wait(2)

    def polled(self, st, info):
        if st is None or self.session:  # CLI занят или отвечает с ошибкой — оставляем, что было
            return False
        old, self.state = self.state, st
        if info is not None:
            self.details, gws = info
            if gws != self.gws:
                self.gws = gws
                self.fill_gateways()
            up = self.details.get("Uptime(sec)", "")
            self.since = time.monotonic() - int(up) if up.isdigit() else None
        if old in ("off", "connecting", None) and st in ("on", "internal") and old is not None:
            notify(f"VPN подключен: {self.where_text()}")
        elif old in ("on", "internal") and st == "off":
            notify("VPN отключен")
        if st in ("on", "internal") and old not in ("on", "internal"):
            self.poke.set()  # сразу подтянуть гейт, IP, время
        self.refresh()
        return False

    # ---------- панель ----------
    def build(self):
        css = Gtk.CssProvider()
        css.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        w = self.win = Gtk.Window(title=T, name="gpvpn", decorated=False, resizable=False,
                                  skip_taskbar_hint=True, skip_pager_hint=True, type_hint=Gdk.WindowTypeHint.UTILITY)
        w.set_keep_above(True)
        w.set_icon_name(ICONS["on"])
        visual = w.get_screen().get_rgba_visual()
        if visual:  # скруглённые углы
            w.set_visual(visual)
            w.set_app_paintable(True)
        w.connect("delete-event", lambda *a: self.hide() or True)
        w.connect("focus-out-event", lambda *a: GLib.timeout_add(200, self.autohide) and False)
        w.connect("key-press-event", lambda _w, e: e.keyval == Gdk.KEY_Escape and (self.hide() or True))
        w.connect("size-allocate", lambda *a: GLib.idle_add(self.place))

        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4, name="card", width_request=330)
        w.add(card)

        head = Gtk.Box(spacing=6)
        head.pack_start(styled(Gtk.Label(label=T, xalign=0), "title"), True, True, 0)
        self.menu = Gtk.Menu()
        items = [("Забыть сохранённую учётную запись", self.forget_user),
                 ("Отправить HIP-отчёт заново", self.resubmit_hip),
                 ("Журнал подключения", self.show_log)]
        items += [(None, None), ("Убрать значок из трея", Gtk.main_quit)]
        for label, cb in items:
            i = Gtk.SeparatorMenuItem() if label is None else Gtk.MenuItem(label=label)
            if cb:
                i.connect("activate", lambda _i, cb=cb: cb())
            self.menu.append(i)
        self.menu.show_all()
        gear = Gtk.MenuButton(popup=self.menu, relief=Gtk.ReliefStyle.NONE,
                              image=Gtk.Image.new_from_icon_name("open-menu-symbolic", Gtk.IconSize.BUTTON))
        head.pack_end(styled(gear, "flat"), False, False, 0)
        card.add(head)

        self.art = Gtk.DrawingArea(height_request=150)
        self.art.connect("draw", lambda a, cr: draw_globe(cr, a.get_allocated_width(), a.get_allocated_height(),
                                                          self.shown_state(), self.angle))
        card.add(self.art)
        self.status = styled(Gtk.Label(), "status")
        self.where = styled(Gtk.Label(ellipsize=Pango.EllipsizeMode.END), "muted")
        self.info = styled(Gtk.Label(), "muted")
        for x in (self.status, self.where, self.info):
            card.add(x)

        # Вход: портал, логин, пароль (пароль можно не вводить, если клиент его сохранил)
        self.form = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        self.e_portal = self.field(self.form, "Адрес портала")
        self.e_login = self.field(self.form, "Логин")
        self.e_pw = self.field(self.form, "Пароль", visible=False)
        self.e_portal.set_text(gpvpn.portal())
        self.e_login.set_text(read(os.path.join(CONF, "login")))
        card.add(self.form)

        # Вопрос клиента: код, выбор из списка, «да/нет»
        self.qbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6, margin_top=6)
        self.q_text = styled(Gtk.Label(xalign=0, wrap=True, max_width_chars=38, selectable=True), "question")
        self.q_entry = Gtk.Entry(activates_default=False)
        self.q_entry.connect("activate", lambda *a: self.answer())
        self.q_combo = Gtk.ComboBoxText()
        self.q_yesno = Gtk.Box(spacing=8, homogeneous=True)
        for label, value in (("Да", "y"), ("Нет", "n")):
            b = styled(Gtk.Button(label=label), "main")
            b.connect("clicked", lambda _b, v=value: self.answer(v))
            self.q_yesno.add(b)
        q_cancel = styled(Gtk.Button(label="Отменить", halign=Gtk.Align.START), "link")
        q_cancel.connect("clicked", lambda *a: self.session and self.on_button_cancel())
        for x in (self.q_text, self.q_entry, self.q_combo, self.q_yesno, q_cancel):
            self.qbox.add(x)
        card.add(self.qbox)

        self.gw_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        self.gw_box.add(styled(Gtk.Label(label="Гейт", xalign=0), "caption"))
        self.combo = Gtk.ComboBoxText()
        self.combo.connect("changed", self.on_gateway)
        self.gw_box.add(self.combo)
        card.add(self.gw_box)

        self.errbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2, margin_top=6)
        self.error = styled(Gtk.Label(xalign=0, wrap=True, max_width_chars=38, selectable=True), "error")
        logbtn = styled(Gtk.Button(label="Открыть журнал", halign=Gtk.Align.START), "link")
        logbtn.connect("clicked", lambda *a: self.show_log())
        self.errbox.add(self.error)
        self.errbox.add(logbtn)
        card.add(self.errbox)

        self.button = styled(Gtk.Button(), "main")
        self.button.connect("clicked", lambda *a: self.on_button())
        card.add(self.button)
        card.show_all()
        self.errbox.hide()
        self.qbox.hide()
        self.fill_gateways()

    def field(self, box, caption, visible=True):
        box.add(styled(Gtk.Label(label=caption, xalign=0), "caption"))
        e = Gtk.Entry(visibility=visible)
        e.connect("activate", lambda *a: self.on_button())
        box.add(e)
        return e

    def shown_state(self):
        return self.busy or self.state or "off"

    def where_text(self):
        d = self.details
        gw = d.get("Gateway Description") or d.get("Gateway Name") or ""
        portal = gpvpn.portal() or self.e_portal.get_text().strip()
        pref = next((n for n, _, p in self.gws if p), None)
        if self.state in ("on", "internal") and gw:
            gw = gw if pref else f"{AUTO} → {gw}"
        elif not gw:
            gw = pref or AUTO
        return " · ".join(x for x in (gw, portal) if x) or "Портал не задан"

    def refresh(self):
        st = self.shown_state()
        sc = self.status.get_style_context()
        for k in TITLES:
            sc.remove_class(k)
        sc.add_class(st)
        self.status.set_text(TITLES[st])
        self.where.set_text(self.where_text())
        if st in ("on", "internal"):
            ip = self.details.get("Assigned IP Address") or "—"
            text = f"IP {ip}"
            if self.since is not None:
                t = int(time.monotonic() - self.since)
                text += f"   ·   {t // 3600:02}:{t // 60 % 60:02}:{t % 60:02}"
            self.info.set_text(text)
        self.info.set_visible(st in ("on", "internal"))

        asking = self.question is not None
        kind = self.question[0] if asking else None
        self.qbox.set_visible(asking)
        self.q_entry.set_visible(kind in ("text", "secret"))
        self.q_combo.set_visible(kind == "choice")
        self.q_yesno.set_visible(kind == "confirm")
        self.form.set_visible(st == "off" and not self.session)
        self.gw_box.set_visible(not asking and bool(self.gws))

        if asking and kind != "confirm":
            label, stop = "Ответить", False
        elif self.session:
            label, stop = "Отмена", True
        elif st == "off":
            label, stop = "Подключить", False
        else:
            label, stop = "Отключить", True
        self.button.set_label(label)
        bc = self.button.get_style_context()
        (bc.add_class if stop else bc.remove_class)("stop")
        self.combo.set_sensitive(not self.session)

        self.icon.set_from_icon_name(ICONS[st])
        self.icon.set_tooltip_text(f"{T}: {TITLES[st]}" + (f" — {self.where_text()}" if st in ("on", "internal") else ""))
        self.art.queue_draw()
        if st in BUSY and not self.spinning and self.win.get_visible():
            self.spinning = GLib.timeout_add(30, self.spin)

    def spin(self):
        self.angle = (self.angle + 0.09) % (2 * math.pi)
        self.art.queue_draw()
        if self.shown_state() in BUSY and self.win.get_visible():
            return True
        self.spinning = None
        return False

    def fill_gateways(self):
        self.filling = True
        self.combo.remove_all()
        self.combo.append("", AUTO)
        for name, addr, _ in self.gws:
            self.combo.append(name, name)
        self.combo.set_active_id(next((n for n, _, p in self.gws if p), ""))
        self.filling = False

    def toggle(self, at_pointer=False):
        if self.win.get_visible():
            return self.hide()
        if time.monotonic() - self.hidden_at < 0.4:  # этот щелчок по значку и скрыл панель
            return
        # Расширение трея рисует значок в оболочке, его координат GTK не знает — ставим по месту щелчка
        self.anchor = Gdk.Display.get_default().get_default_seat().get_pointer().get_position()[1:] if at_pointer else None
        self.refresh()
        self.place()
        self.win.show()
        self.win.present_with_time(Gtk.get_current_event_time())
        (self.e_pw if self.e_portal.get_text() and self.e_login.get_text() else self.e_portal).grab_focus()
        self.refresh()

    def show_panel(self):
        if self.win.get_visible():
            self.win.present()
        else:
            self.hidden_at = 0
            self.toggle()

    def hide(self):
        if self.question:  # пока клиент ждёт ответа — не прячем
            return
        self.win.hide()
        self.hidden_at, self.pos = time.monotonic(), None
        self.errbox.hide()

    def autohide(self):
        if (self.win.get_visible() and not self.win.is_active() and not self.menu.get_visible()
                and not self.combo.get_property("popup-shown") and not self.q_combo.get_property("popup-shown")):
            self.hide()
        return False

    def place(self):
        # У значка: над панелью задач (или под ней, если она сверху); без щелчка — в правом нижнем углу
        _, nat = self.win.get_preferred_size()
        w, h, m = nat.width, nat.height, 8
        disp = Gdk.Display.get_default()
        mon = disp.get_monitor_at_point(*self.anchor) if self.anchor else (disp.get_primary_monitor() or disp.get_monitor(0))
        wa = mon.get_workarea()
        x, y = wa.x + wa.width - w - m, wa.y + wa.height - h - m
        if self.anchor:
            x = self.anchor[0] - w // 2
            if self.anchor[1] < wa.y + wa.height // 2:
                y = wa.y + m
        x = max(wa.x + m, min(x, wa.x + wa.width - w - m))
        y = max(wa.y + m, min(y, wa.y + wa.height - h - m))
        if (x, y) != self.pos:
            self.pos = (x, y)
            self.win.move(x, y)
        return False

    # ---------- диалоги с CLI ----------
    def run(self, args, busy, **creds):
        self.errbox.hide()
        self.busy, self.question = busy, None
        self.session = Session(args, creds, self.ask, self.on_done)
        self.refresh()

    def ask(self, s, kind, text, options=()):
        self.question = (kind, s)
        self.q_text.set_text(text)
        self.q_entry.set_text("")
        self.q_entry.set_visibility(kind != "secret")
        self.q_combo.remove_all()
        for n, label in options:
            self.q_combo.append(n, label)
        if options:
            self.q_combo.set_active(0)
        self.refresh()
        if not self.win.get_visible():
            notify("GlobalProtect ждёт ответа")
            self.show_panel()
        if kind in ("text", "secret"):
            self.q_entry.grab_focus()

    def answer(self, value=None):
        if not self.question:
            return
        kind, s = self.question
        if value is None:
            value = self.q_combo.get_active_id() if kind == "choice" else self.q_entry.get_text()
        self.question = None
        self.q_entry.set_text("")
        s.send(value or "")
        self.refresh()

    def on_done(self, s, e):
        if s is not self.session:
            return
        self.log.append(f"$ globalprotect {' '.join(s.args)}\n{e['output']}".strip())
        self.log = self.log[-20:]
        self.session, self.question, busy = None, None, self.busy
        self.busy = None
        problem, cancelled = e["error"], e["cancelled"] or s.cancelling
        if busy == "connecting" and not cancelled and (e["rc"] or problem):
            self.fail("Не удалось подключиться.", problem)
            self.pw = None
        elif busy == "connecting" and not cancelled:
            self.pw = self.pending_pw or self.pw
            self.e_pw.set_text("")
        elif e["rc"] and not cancelled and problem:
            self.fail("Команда не выполнена.", problem)
        self.pending_pw = None
        self.poke.set()
        self.refresh()

    def on_button_cancel(self):
        self.session.cancel()
        self.question = None
        self.refresh()

    def on_button(self):
        if self.question and self.question[0] != "confirm":
            return self.answer()
        if self.session:
            return self.on_button_cancel()
        if self.shown_state() == "off":
            self.connect()
        else:
            self.run(["disconnect"], "disconnecting")

    def connect(self, gateway=None):
        portal = self.e_portal.get_text().strip().split("://")[-1].split("/")[0]
        if not portal:
            return self.fail("Введите адрес портала.")
        login = self.e_login.get_text().strip()
        if login:
            save_login(login)
        pw = self.e_pw.get_text() or self.pw
        self.pending_pw = pw
        args = ["connect", "--portal", portal] + (["--username", login] if login else [])
        self.run(args, "connecting", login=login, password=pw, gateway=gateway)

    def on_gateway(self, combo):
        if self.filling or self.session:
            return
        name = combo.get_active_id() or None

        def work():
            rc, out = gp("set-preferred-gateway", *(["--name", name] if name else []))
            GLib.idle_add(self.gateway_set, rc, out, name)
        threading.Thread(target=work, daemon=True).start()

    def gateway_set(self, rc, out, name):
        if rc and friendly(out):
            self.fail("Не удалось выбрать гейт.", friendly(out))
        elif self.state in ("on", "internal"):
            # Переподключение к выбранному гейту (или к лучшему — для автовыбора)
            self.run(["rediscover-network"], "connecting", login=self.e_login.get_text().strip(), password=self.pw, gateway=name)
        self.poke.set()
        return False

    def forget_user(self):
        self.pw = None
        self.run(["remove-user"], "disconnecting" if self.state in ("on", "internal") else None, yes=True)

    def resubmit_hip(self):
        def work():
            rc, out = gp("resubmit-hip", timeout=120)
            GLib.idle_add(lambda: notify("HIP-отчёт отправлен") if rc == 0 else self.fail("HIP-отчёт не отправлен.", friendly(out) or out[-300:]))
        threading.Thread(target=work, daemon=True).start()

    def show_log(self):
        win = Gtk.Window(title=f"{T} — журнал подключения", default_width=780, default_height=440)
        win.set_icon_name(ICONS["on"])
        tv = Gtk.TextView(editable=False, monospace=True, wrap_mode=Gtk.WrapMode.WORD_CHAR,
                          left_margin=10, right_margin=10, top_margin=8, bottom_margin=8)
        buf = tv.get_buffer()
        buf.set_text("\n\n".join(self.log) or "Журнал пуст")
        buf.place_cursor(buf.get_end_iter())
        sw = Gtk.ScrolledWindow()
        sw.add(tv)
        win.add(sw)
        win.show_all()
        GLib.idle_add(tv.scroll_mark_onscreen, buf.get_insert())

        def errors():
            text = "\n\n".join(x for x in (gp("show", "--error")[1], gp("show", "--notification")[1]) if x)
            GLib.idle_add(lambda: buf.insert(buf.get_end_iter(), "\n\n— Сообщения клиента —\n" + text) and False)
        threading.Thread(target=errors, daemon=True).start()

    def fail(self, text, details=""):
        self.error.set_text(text + ("\n" + details if details else ""))
        if not self.win.get_visible():
            notify(text)
            self.show_panel()
        self.errbox.show()
        self.refresh()


# Один экземпляр на пользователя; повторный запуск (ярлык в меню) открывает панель уже запущенного
lock = open(os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "gp-vpn-tray.lock"), "a+")
try:
    fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
except OSError:
    lock.seek(0)
    try:
        os.kill(int(lock.read().strip()), signal.SIGUSR1)
    except (ValueError, OSError):
        pass
    sys.exit(0)
lock.truncate(0)
lock.write(str(os.getpid()))
lock.flush()

Notify.init(T)
tray = Tray()
GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGUSR1, lambda: tray.show_panel() or True)
GLib.timeout_add_seconds(1, lambda: tray.refresh() or True)  # время подключения
if "--show" in sys.argv:
    GLib.idle_add(lambda: tray.show_panel() or False)
Gtk.main()
