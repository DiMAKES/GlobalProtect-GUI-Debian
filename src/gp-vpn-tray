def read(path):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return ""


def save_login(login):
    os.makedirs(CONF, exist_ok=True)
    with open(os.path.join(CONF, "login"), "w") as f:
        f.write(login + "\n")


def notify(text):
