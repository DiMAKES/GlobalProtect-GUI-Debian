#!/bin/bash
# Root-часть VPN. Любой пользователь и экран входа запускают её через sudo без пароля,
# поэтому аргументы строго проверяются, а секреты приходят только через stdin.
# Сам VPN работает системной службой gp-vpn — не рвётся при входе/выходе из УЗ.
#
#   gp-vpn connect <портал> <гейт|auto> <логин|-> <password|cookie> [сертификат]
#       password — stdin: пароль;  cookie — stdin: результат gpauth (вход через SSO/SAML)
#       сертификат (.p12/.pfx/.pem) — свой файл пользователя; пароль от него — первой строкой stdin
#   gp-vpn disconnect
STATE=/var/lib/gp-vpn
RUN=/run/gp-vpn

case "${1:-}" in
  connect)
    P="${2:-}" LOC="${3:-}" U="${4:-}" AUTH="${5:-}" CERT="${6:-}"
    [[ "$P" =~ ^[A-Za-z0-9][-A-Za-z0-9.]*(:[0-9]+)?$ ]] || { echo "Недопустимый адрес портала: $P" >&2; exit 2; }
    [[ -n "$LOC" && "$LOC" != -* && "$LOC" != *[\$%[:cntrl:]]* ]] || { echo "Недопустимое имя гейта: $LOC" >&2; exit 2; }
    [[ "$U" = - || "$U" =~ ^[A-Za-z0-9][-A-Za-z0-9._@\\]*$ ]]   || { echo "Недопустимый логин: $U" >&2; exit 2; }
    [[ "$AUTH" = password || "$AUTH" = cookie ]]                || { echo "Недопустимый способ входа: $AUTH" >&2; exit 2; }

    systemctl stop gp-vpn 2>/dev/null
    mkdir -p "$STATE" "$RUN"
    chmod 700 "$RUN"
    rm -f "$RUN"/* /run/gp-vpn.gateway
    ARGS=()

    if [ -n "$CERT" ]; then
      # Только обычный файл самого пользователя: root не читает чужие файлы по его просьбе
      [ -f "$CERT" ] && [ ! -L "$CERT" ] && [ "$(stat -c %u -- "$CERT")" = "${SUDO_UID:-0}" ] ||
        { echo "Сертификат не найден или принадлежит другому пользователю: $CERT" >&2; exit 2; }
      IFS= read -r KEYPW
      export KEYPW
      (
        umask 077
        case "${CERT,,}" in
          *.p12|*.pfx)
            openssl pkcs12 -in "$CERT" -nodes -passin env:KEYPW -out "$RUN/client.pem" 2>/dev/null ||
              openssl pkcs12 -legacy -in "$CERT" -nodes -passin env:KEYPW -out "$RUN/client.pem" 2>/dev/null ;;
          *)
            { openssl x509 -in "$CERT" && openssl pkey -in "$CERT" -passin env:KEYPW; } >"$RUN/client.pem" 2>/dev/null ;;
        esac
      ) || { rm -f "$RUN/client.pem"; echo "Не удалось открыть сертификат — неверный пароль от него?" >&2; exit 2; }
      unset KEYPW
      ARGS+=(-c "$RUN/client.pem")
    fi

    # Остаток stdin — пароль или результат gpauth; файл 0600 в /run/gp-vpn, только root
    SECRET=$(mktemp -p "$RUN")
    cat >"$SECRET"

    [ "$LOC" = auto ] && ARGS+=(--auto-gateway) || ARGS+=(--gateway "$LOC")
    ARGS+=(--interface gpvpn0)  # своё имя: панель отличает наш туннель от чужих tun (прокси и т. п.)
    [ "$AUTH" = cookie ] && ARGS+=(--cookie-on-stdin) || ARGS+=(--user "$U" --passwd-on-stdin)

    # Запоминаем для всех (окно на экране входа и у каждого пользователя)
    printf 'PORTAL=%q\nLOGIN=%q\nLOCATION=%q\nAUTH=%q\nCERT=%q\n' "$P" "$U" "$LOC" "$AUTH" "$CERT" >"$STATE/settings"
    chmod 644 "$STATE/settings"

    # Type=exec: systemd-run возвращается после запуска, файл с секретом уже открыт службой
    systemd-run --quiet --unit=gp-vpn --collect -p Type=exec -p KillMode=mixed \
      -p StandardInput=file:"$SECRET" -p StandardOutput=journal -p StandardError=journal \
      /usr/libexec/gp-vpn/run "${ARGS[@]}" "$P"
    rc=$?
    rm -f "$SECRET"
    exit $rc
    ;;
  disconnect)
    systemctl stop gp-vpn
    rm -f "$RUN"/client.pem /run/gp-vpn.gateway
    ;;
  *)
    echo "Использование: gp-vpn connect <портал> <гейт|auto> <логин|-> <password|cookie> [сертификат]  |  gp-vpn disconnect" >&2
    exit 2
    ;;
esac
