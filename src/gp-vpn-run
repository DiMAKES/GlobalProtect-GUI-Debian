#!/usr/bin/python3
# Запуск gpclient внутри службы gp-vpn (это главный процесс службы; аргументы — для «gpclient connect»).
# gpclient работает с -v, чтобы в журнал попал ответ портала со списком гейтов. Отсюда:
#   /run/gp-vpn.log           — журнал для всех: только INFO/WARN/ERROR, без отладки и служебных куки
#   /var/lib/gp-vpn/gateways  — «# портал», затем строки «название<TAB>адрес» гейтов портала
#   /run/gp-vpn.gateway       — гейт, к которому идёт подключение (адрес или название)
import os, re, signal, subprocess, sys
import xml.etree.ElementTree as ET

LOG = os.environ.get("GP_VPN_LOG", "/run/gp-vpn.log")
STATE = os.environ.get("GP_VPN_STATE", "/var/lib/gp-vpn")
CURRENT = os.environ.get("GP_VPN_CURRENT", "/run/gp-vpn.gateway")
GPCLIENT = os.environ.get("GP_VPN_GPCLIENT", "/usr/bin/gpclient")
STAMP = re.compile(r"^\[\d{4}-\d\d-\d\dT\S+ +(TRACE|DEBUG|INFO|WARN|ERROR) ")


def write(path, text):
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        f.write(text)
    os.chmod(tmp, 0o644)
    os.replace(tmp, path)


def save_gateways(xml, portal):
    try:
        root = ET.fromstring(xml)
    except ET.ParseError:
        return
    rows = []
    for e in root.iterfind(".//gateways/external/list/entry"):
        name = e.get("name", "").strip()
        label = (e.findtext("description") or "").strip() or name
        if name:
            rows.append(f"{label}\t{name}\n")
    if rows:
        write(os.path.join(STATE, "gateways"), f"# {portal}\n" + "".join(rows))


def main():
    portal = sys.argv[-1]
    os.makedirs(STATE, exist_ok=True)
    log = open(LOG, "w", buffering=1)
    os.chmod(LOG, 0o644)
    p = subprocess.Popen([GPCLIENT, "-v", "connect", "--hip", *sys.argv[1:]],
                         stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, errors="replace")
    # systemd (KillMode=mixed) шлёт SIGTERM только нам — передаём gpclient, чтобы он вышел из сессии
    for s in (signal.SIGTERM, signal.SIGINT):
        signal.signal(s, lambda n, f: p.send_signal(n))

    level, xml = "INFO", None
    for line in p.stdout:
        m = STAMP.match(line)
        if m:
            if xml is not None:
                save_gateways("".join(xml), portal)
                xml = None
            level = m.group(1)
            if "] Portal config response: " in line:
                xml = [line.split("] Portal config response: ", 1)[1]]
                continue
        elif xml is not None:
            xml.append(line)
            continue
        g = re.search(r"\(Gateway: ([^)]+)\)|attempting gateway .*\(([^)]+)\)\s*$|selected gateway: (.+)$", line)
        if g:
            write(CURRENT, next(x for x in g.groups() if x).strip() + "\n")
        if level not in ("TRACE", "DEBUG"):
            log.write(line)
    if xml is not None:
        save_gateways("".join(xml), portal)
    sys.exit(p.wait())


main()
