# Двоичный rpm из готового дерева (собирает build.sh): rpmbuild -bb --target <arch>
%global debug_package %{nil}
%global __os_install_post %{nil}
%global _build_id_links none

Name:           gp-vpn
Version:        @VERSION@
Release:        1
Summary:        GlobalProtect VPN client with a Windows-like tray panel
License:        GPL-3.0-or-later
URL:            @URL@
Requires:       python3, python3-gobject, sudo, systemd, openssl, ca-certificates
# Fedora/RHEL — первое имя, openSUSE — второе
Requires:       (iproute or iproute2)
Requires:       (python3-cairo or python3-gobject-cairo)
Requires:       (gtk3 or typelib-1_0-Gtk-3_0)
Requires:       (libnotify or typelib-1_0-Notify-0_7)
Recommends:     gnome-shell-extension-appindicator
Conflicts:      globalprotect-openconnect

%description
Tray icon and panel for GlobalProtect VPN (status, connect/disconnect, gateway
switching on the fly, SSO/SAML, password and client certificate login, login
screen support), the gp-vpn service with HIP report and gpclient/gpauth
@GPCLIENT@ from globalprotect-openconnect (without the paid GUI).

%install
cp -a @ROOT@/. %{buildroot}/

%preun
if [ "$1" -eq 0 ]; then systemctl stop gp-vpn 2>/dev/null || :; fi

%files
@FILES@
